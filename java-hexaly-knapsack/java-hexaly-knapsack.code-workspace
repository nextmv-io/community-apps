{
  "folders": [
    {
      "path": "."
    }
  ],
  "launch": {
    "configurations": [
      {
        "type": "java",
        "name": "Main",
        "request": "launch",
        "mainClass": "com.nextmv.example.Main",
        "projectName": "HexalyJava",
        "env": {
          // Set path to the local libraries for the right arch flavor.
          "LD_LIBRARY_PATH": "/app/local",
        },
        "args": ["--input", "input.json", "--output", "output.json"]
      }
    ]
  },
  "extensions": {
    "recommendations": ["ms-vscode-remote.remote-containers"]
  },
  "settings": {
    "java.configuration.updateBuildConfiguration": "automatic"
  }
}
